classDiagram
    direction LR
    class Animal {
        +String name
        +int age
        +makeSound()
        +move()
    }
    
    class Dog {
        +String breed
        +bark()
        +fetch()
    }
    
    class Cat {
        +int lives
        +meow()
        +purr()
    }
    
    class Owner {
        +String name
        +adoptPet()
    }
    
    Animal <|-- Dog : inherits
    Animal <|-- Cat : inherits
    Owner "1" --> "*" Animal : owns
    Dog ..> Owner : depends on
