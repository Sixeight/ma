stateDiagram-v2
    direction LR
    [*] --> Idle
    Idle --> Processing : start
    Processing --> Success : complete
    Processing --> Failed : error
    Success --> [*]
    Failed --> Retry : retry
    Retry --> Processing
    Failed --> [*] : abort
    
    state Processing {
        [*] --> Validate
        Validate --> Execute
        Execute --> [*]
    }
